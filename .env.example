# ═══════════════════════════════════════════════════════
#  ChatRoom – environment variables
#  cp .env.example .env   then fill it in before `docker compose up`
#  The values below work for a local demo. Change every one of them for anything public.
# ═══════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=chatroom
DB_USERNAME=root
DB_PASSWORD=root

# ── TLS ─────────────────────────────────────────────────
# Certificates for Nginx, the backend and MySQL come from the Certificate Controller
# (certificates/), which creates its own CA on the first start. Nothing to configure.

# ── JWT ─────────────────────────────────────────────────
# Must be Base64 and decode to at least 32 bytes (HS256). Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48

# ── Email (2FA codes) ───────────────────────────────────
# By default mail goes to the bundled Mailpit container: open http://localhost:8025 to read it.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=chatroom@localhost
MAIL_PASSWORD=unused
# To send real email through Gmail instead, use an App Password (not your real password):
# Google Account → Security → 2-Step Verification → App passwords
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.email@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Seeded administrator ────────────────────────────────
# Email of the "admin" account created on the first start; its 2FA codes go here
ADMIN_EMAIL=admin@gmail.com

# ── Google sign-in (optional) ───────────────────────────
# OAuth client ID of the web app; the backend accepts only Google tokens issued to it.
# Leave the default to use the project's client, or empty to switch Google sign-in off.
GOOGLE_CLIENT_ID=18241292903-s66g5vbbvur80d9jd47j9uh58ljll2s4.apps.googleusercontent.com
